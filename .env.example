# Copie para .env e ajuste antes de subir com docker compose

JWT_SECRET=troque_esta_chave_por_uma_bem_grande_e_aleatoria

# Credenciais de Sandbox/Produção do Wellhub Technical Sales (ver README, "Integração Wellhub").
# gym_id e api_key vêm do JSON de credenciais compartilhado por e-mail.
# Sandbox: https://apitesting.partners.gympass.com — Produção: https://api.partners.gympass.com
WELLHUB_BASE_URL=https://apitesting.partners.gympass.com
WELLHUB_API_KEY=

# Secret que NÓS escolhemos para assinar o X-Gympass-Signature (gere com `openssl rand -hex 32`
# e envie de volta ao Wellhub Technical Sales junto com a URL pública do webhook).
WELLHUB_WEBHOOK_SECRET=troque_este_segredo_do_webhook

# Cobrança (Stripe) — assinatura mensal por tenant (ver README, "Cobrança / Stripe").
# Chaves de teste (sandbox): https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
# Secret do endpoint de webhook (whsec_...): https://dashboard.stripe.com/test/webhooks
STRIPE_WEBHOOK_SECRET=
# Preço de exemplo (R$ 99,00/mês) — ajuste quando decidir o valor real, não precisa mexer em código.
STRIPE_PRICE_AMOUNT_CENTS=9900
STRIPE_CURRENCY=brl

FRONTEND_URL=http://localhost:5271
VITE_API_URL=http://localhost:5280/api
